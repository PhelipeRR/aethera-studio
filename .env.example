# Aethera Studio Web — Variáveis de Ambiente
PORT=3000
NODE_ENV=development
AETHERA_DB_PATH=apps/aethera-web/data/aethera-web.db

# Segurança & Autenticação (obrigatórias em produção, fora do banco e do repositório)
# Gere uma chave de 32 bytes em hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AETHERA_CREDENTIAL_KEY=
# Token de implantação para liberar o cadastro inicial do administrador (obrigatório em produção)
AETHERA_ADMIN_SETUP_TOKEN=
# Lista separada por vírgula de origens HTTPS autorizadas no CORS (ex.: https://studio.seudominio.com)
AETHERA_ALLOWED_ORIGINS=
# Em produção, exige HTTPS (x-forwarded-proto=https ou TLS direto)
AETHERA_ENFORCE_HTTPS=true
# Permite apontar Remote Host para http://127.0.0.1 / localhost apenas em desenvolvimento local
AETHERA_ALLOW_LOOPBACK_REMOTE_HOST=true

# Provedores Opcionais do Estúdio
VOICESTUDIO_URL=http://127.0.0.1:3900
OLLAMA_HOST=http://127.0.0.1:11434
ELEVENLABS_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/youtube/callback
