# Aethera Remote Host — Exemplo de configuração (copie para .env.local ou deixe o script PowerShell gerar)
# NUNCA commite o arquivo .env.local com tokens reais no Git!

AETHERA_REMOTE_BIND_HOST=127.0.0.1
AETHERA_REMOTE_PORT=4848
AETHERA_REMOTE_TOKEN=
AETHERA_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.run.app,https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.trycloudflare.com
AETHERA_RATE_LIMIT_WINDOW_MS=60000
AETHERA_RATE_LIMIT_MAX=240
OLLAMA_HOST=http://127.0.0.1:11434
