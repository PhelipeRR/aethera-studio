{
  "name": "neuralbridge",
  "private": true,
  "version": "0.1.79",
  "description": "NeuralBridge Monorepo — Aethera Studio Web & Desktop coexistence",
  "type": "module",
  "workspaces": [
    "apps/aethera-web",
    "apps/aethera-remote-host"
  ],
  "monorepoDesktopWorkspacesNote": "Os apps Electron (apps/aethera-desktop, apps/desktop, apps/orchestrator-desktop, apps/void-desktop, apps/mobile) e packages/* foram preservados intactos; o workspace ativo foi isolado em apps/aethera-web e apps/aethera-remote-host porque os pacotes internos @neuralbridge/* ausentes no import causariam erro 404 no npm install.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx apps/aethera-web/server.ts",
    "start": "NODE_ENV=production tsx apps/aethera-web/server.ts",
    "build": "vite build --config apps/aethera-web/vite.config.ts",
    "dev:web": "tsx apps/aethera-web/server.ts",
    "start:web": "NODE_ENV=production tsx apps/aethera-web/server.ts",
    "build:web": "vite build --config apps/aethera-web/vite.config.ts",
    "dev:remote-host": "tsx apps/aethera-remote-host/src/server.ts",
    "start:remote-host": "NODE_ENV=production tsx apps/aethera-remote-host/src/server.ts",
    "typecheck": "tsc -p apps/aethera-web/tsconfig.json --noEmit && tsc -p apps/aethera-remote-host/tsconfig.json --noEmit",
    "typecheck:web": "tsc -p apps/aethera-web/tsconfig.json --noEmit",
    "typecheck:remote-host": "tsc -p apps/aethera-remote-host/tsconfig.json --noEmit",
    "lint": "eslint apps/aethera-web/src apps/aethera-web/server apps/aethera-web/server.ts apps/aethera-web/test apps/aethera-remote-host/src apps/aethera-remote-host/test",
    "test": "tsx --test apps/aethera-web/test/aethera-web.test.ts apps/aethera-web/test/auth-remote-proxy.test.ts apps/aethera-remote-host/test/remote-host.test.ts apps/aethera-remote-host/test/bidirectional-sync.test.ts",
    "test:web": "tsx --test apps/aethera-web/test/aethera-web.test.ts apps/aethera-web/test/auth-remote-proxy.test.ts",
    "test:remote-host": "tsx --test apps/aethera-remote-host/test/remote-host.test.ts apps/aethera-remote-host/test/bidirectional-sync.test.ts",
    "dev:desktop": "npm --prefix apps/desktop run dev",
    "dev:aethera": "npm --prefix apps/aethera-desktop run dev",
    "dev:orchestrator": "npm --prefix apps/orchestrator-desktop run dev",
    "dev:void": "npm --prefix apps/void-desktop run dev",
    "build:desktop": "npm --prefix apps/desktop run build",
    "build:aethera": "bun run --cwd apps/aethera-desktop build",
    "build:orchestrator": "npm --prefix apps/orchestrator-desktop run build",
    "build:void": "npm --prefix apps/void-desktop run build",
    "build:all-apps": "npm run build:web && npm run build:desktop && npm run build:aethera && npm run build:orchestrator && npm run build:void",
    "typecheck:desktop": "npm --prefix apps/aethera-desktop run typecheck",
    "dist:win:aethera": "bun run build:aethera && cd apps/aethera-desktop && bunx electron-builder --config electron-builder.yml --win",
    "dist:win:desktop": "npm run build:desktop && cd apps/desktop && ../../node_modules/.bin/electron-builder --config electron-builder.yml --win",
    "dist:win:orchestrator": "npm run build:orchestrator && cd apps/orchestrator-desktop && ../../node_modules/.bin/electron-builder --config electron-builder.yml --win",
    "dist:win:void": "npm run build:void && cd apps/void-desktop && electron-builder --config electron-builder.yml --win",
    "dist:win:all": "npm run dist:win:aethera && npm run dist:win:desktop && npm run dist:win:orchestrator && npm run dist:win:void"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.2.0",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "^4.0.545",
    "@remotion/media-utils": "^4.0.545",
    "@remotion/player": "^4.0.545",
    "@remotion/renderer": "^4.0.545",
    "@tanstack/react-query": "^5.108.2",
    "@types/express": "^5.0.6",
    "@urql/core": "^6.0.3",
    "@xyflow/react": "^13.0.2",
    "adm-zip": "^0.6.1",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.2.0",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "cross-spawn": "^7.0.6",
    "cytoscape-fcose": "^2.2.0",
    "debug": "^4.4.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "fs-extra": "^11.4.1",
    "glob": "^14.0.6",
    "jsonfile": "^6.2.1",
    "lucide-react": "^1.77.0",
    "minimatch": "^11.0.9",
    "motion": "^14.14.0",
    "node-fetch": "^3.3.2",
    "onnxruntime-node": "^1.31.1",
    "pdfjs-dist": "^6.5.438",
    "plist": "^5.1.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.2",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.545",
    "semver": "^7.8.6",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "tar": "^7.5.23",
    "tesseract.js": "^7.0.0",
    "three": "^0.187.0",
    "tmp-promise": "^3.0.3",
    "tw-animate-css": "^1.4.0",
    "urql": "^5.0.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.9.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.23.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.0"
  }
}
